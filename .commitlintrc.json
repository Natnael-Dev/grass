{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      ["feat", "fix", "perf", "refactor", "test", "docs", "build", "ci", "chore", "style", "revert"]
    ],
    "scope-enum": [
      2,
      "always",
      [
        "core",
        "world",
        "grass",
        "sky",
        "camera",
        "input",
        "audio",
        "ui",
        "easter",
        "debug",
        "build",
        "tracking",
        "docs"
      ]
    ]
  }
}
